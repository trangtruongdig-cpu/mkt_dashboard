# Sao chép thành .env rồi chỉnh. KHÔNG commit file .env.

# development | test | production
NODE_ENV=development

# Cổng máy chủ API khi chạy cục bộ hoặc trong Docker
PORT=3001

# Origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Khi triển khai thật hãy thay bằng tên miền của frontend, đừng để "*".
CORS_ORIGINS=http://localhost:3000

# demo     = dùng bộ số liệu giả lập trong @ptit/shared
# postgres = đọc các bảng mart__* do dbt sinh ra
DATA_SOURCE=demo

# ─── Uỷ quyền Google Analytics ────────────────────────────────────────────────
# Đây là nơi DUY NHẤT được chứa bí mật Google (CLAUDE.md mục 4). Không ghi ra file
# trong repo, không log, không trả qua API. Để trống khi chưa đấu nối — màn hình
# Kết nối vẫn dựng được và hướng dẫn từng bước.

# OAuth client tạo trên Google Cloud Console, loại "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lấy được sau khi chạy xong luồng OAuth ở màn hình Kết nối. Luồng đó chỉ giữ token
# trong bộ nhớ tiến trình — chép vào đây rồi dựng lại container thì mới giữ được
# qua lần khởi động sau.
GOOGLE_REFRESH_TOKEN=

# Property GA4 chọn để đồng bộ, dạng số thuần (ví dụ 464491273).
GA4_PROPERTY_ID=
