# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# --- Google Analytics 4 -------------------------------------------------------
# Lấy từ URL khi mở GA4: .../a<ACCOUNT>p<PROPERTY>/... — phần sau chữ "p".
GA4_PROPERTY_ID=464491273

# OAuth của tài khoản Google đang có quyền xem property.
# Quyền "viewer" là đủ — không cần quyền quản trị.
# Cách lấy 3 giá trị dưới: uv run python scripts/get_ga4_refresh_token.py
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=

# Ngày bắt đầu hút dữ liệu. GA4 chỉ giữ tối đa 14 tháng nên lùi quá xa cũng không có gì.
GA4_START_DATE=2025-07-01

# Số ngày mỗi lần gọi API. Nhỏ hơn = nhiều lệnh gọi hơn nhưng ít bị lấy mẫu hơn.
GA4_WINDOW_IN_DAYS=30

# --- Crawler earned media (tin bài công khai) ---------------------------------
# Không cần token gì cả — mọi nguồn đều công khai. Nguồn và từ khoá cấu hình ở
# apps/worker/config/media-sources.json và brand-keywords.json.

# Tự giới thiệu khi gọi vào máy chủ của các báo. PHẢI thuần ASCII (không dấu tiếng Việt)
# vì tiêu đề HTTP mã hoá bằng latin-1. Nên để lại địa chỉ liên hệ thật.
CRAWLER_USER_AGENT=PTIT-BrandMonitor/0.1 (academic research; +https://ptit.edu.vn)

# Giãn cách giữa hai lần gọi cùng một tên miền, tính bằng giây. Đừng hạ dưới 1 —
# gọi dồn dập vào máy chủ của báo là hành vi xấu và sẽ bị chặn IP.
CRAWLER_DOMAIN_DELAY=1.5

# Thời gian chờ tối đa mỗi lần gọi HTTP, tính bằng giây.
CRAWLER_TIMEOUT=25

CRAWLER_DUCKDB_PATH=.data/ptit_news.duckdb
CRAWLER_SCHEMA=news_raw

# --- Nơi chứa dữ liệu ---------------------------------------------------------
# duckdb   = file cục bộ, chạy được ngay, không cần Docker (dùng lúc này)
# postgres = kho thật của hệ thống (khi đã dựng Docker Compose)
# Biến này chi phối cả job GA4 lẫn crawler.
INGEST_CACHE=duckdb
DUCKDB_PATH=.data/ptit_ga4.duckdb

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ptit_dashboard
POSTGRES_USER=ptit
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=ga4_raw
