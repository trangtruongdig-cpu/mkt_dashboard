{
  "compilerOptions": {
    "target": "ES2022",
    // DOM chỉ để lấy kiểu `URL` và `URLSearchParams` — có sẵn ở cả Node lẫn trình
    // duyệt. Gói này chạy hai phía nên KHÔNG được dùng document/window.
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
