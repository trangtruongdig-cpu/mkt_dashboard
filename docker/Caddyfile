# Reverse proxy đứng trước toàn hệ thống. Đây là service duy nhất mở cổng ra ngoài.
#
# Web và API chung một tên miền là có chủ đích: cookie phiên đăng nhập khi đó là
# same-origin, không cần nới lỏng SameSite và không vướng chặn cookie bên thứ ba.

{
	# Mặc định phục vụ HTTP để chạy được ngay trên máy chưa có tên miền.
	# Khi triển khai thật, đổi `:80` bên dưới thành tên miền của Học viện là Caddy
	# tự xin chứng chỉ Let's Encrypt.
	auto_https off
}

:80 {
	encode zstd gzip

	# Tài liệu OpenAPI và toàn bộ endpoint đi về NestJS.
	handle /api/* {
		reverse_proxy api:3002
	}

	# Metabase cho cán bộ tự truy vấn ad-hoc.
	handle /metabase/* {
		reverse_proxy metabase:3000
	}

	# Matomo đo lưu lượng website của Học viện.
	#
	# `handle_path` cắt tiền tố trước khi chuyển tiếp, vì Matomo tự dựng đường dẫn tương
	# đối từ gốc tài liệu của nó. Chạy dưới đường dẫn con như vậy đủ dùng cho bản tự dựng;
	# nếu cần nhúng mã theo dõi lên nhiều tên miền thì chuyển Matomo sang tên miền con
	# riêng (matomo.ptit.edu.vn) rồi đổi khối này thành một site riêng.
	handle_path /matomo/* {
		reverse_proxy matomo:80
	}

	# Còn lại là giao diện Next.js.
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
