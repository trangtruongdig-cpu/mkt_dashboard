# Biến môi trường của TOÀN HỆ THỐNG (docker-compose.yml đọc file này).
#
#     cp .env.example .env      # rồi sửa hai mật khẩu bắt buộc bên dưới
#     docker compose up -d --build
#
# Hai biến có dấu `:?` trong docker-compose.yml là BẮT BUỘC — thiếu thì compose dừng ngay
# kèm thông báo, không dựng nửa vời. Các biến còn lại đều có giá trị mặc định.
#
# File .env KHÔNG BAO GIỜ được commit. Mỗi biến mới thêm vào compose phải có mặt ở đây
# kèm chú thích tiếng Việt — mục 8 CLAUDE.md.

# --- Bắt buộc ----------------------------------------------------------------
# Mật khẩu PostgreSQL. Đặt chuỗi ngẫu nhiên dài, không dùng lại mật khẩu ở nơi khác.
POSTGRES_PASSWORD=doi_mat_khau_nay

# Mật khẩu đăng nhập màn hình quản trị (http://localhost:8080/quan-tri).
ADMIN_PASSWORD=doi_mat_khau_nay

# --- Nguồn dữ liệu của API ----------------------------------------------------
# demo     — số liệu giả lập trong @ptit/shared. Chạy được ngay khi chưa có kho, và
#            giao diện tự ghi "Nguồn: số liệu giả lập" để không ai nhầm là số thật.
# postgres — đọc các bảng mart__* do dbt sinh ra. Chỉ đặt khi đã chạy `dbt build`.
#
# Biến này chi phối cả module KPI lẫn module dashboard — dùng chung một cần gạt để không
# bao giờ xảy ra cảnh cascade đọc số thật mà biểu đồ ngay bên cạnh vẫn vẽ số giả.
DATA_SOURCE=demo

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=ptit_dashboard
POSTGRES_USER=ptit

# Cơ sở dữ liệu riêng của Metabase, nằm cùng máy chủ PostgreSQL nhưng tách hẳn kho dữ liệu.
METABASE_DB=metabase

# --- Địa chỉ công khai --------------------------------------------------------
# Trình duyệt gọi API qua địa chỉ này, và API dùng nó cho CORS. Khi triển khai thật thì
# đổi thành tên miền của Học viện, ví dụ https://dashboard.ptit.edu.vn
PUBLIC_URL=http://localhost:8080

# Cổng Caddy mở ra ngoài. Chỉ service này publish cổng; các service khác chỉ gọi được
# trong mạng nội bộ của Docker.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Phiên đăng nhập quản trị -------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Quản trị viên
SESSION_TTL_HOURS=12

# Bật khi đã có HTTPS thật. Để false thì cookie mới gửi được qua http://localhost —
# đặt true lúc chạy local sẽ khiến đăng nhập thành công nhưng lần tải trang sau lại
# hỏi đăng nhập tiếp, rất khó đoán ra nguyên nhân.
SESSION_COOKIE_SECURE=false

# --- Worker thu thập ----------------------------------------------------------
# Tự giới thiệu khi gọi vào máy chủ của các báo và diễn đàn. PHẢI thuần ASCII (không dấu
# tiếng Việt) vì tiêu đề HTTP mã hoá bằng latin-1. Nên để lại địa chỉ liên hệ thật.
CRAWLER_USER_AGENT=PTIT-BrandMonitor/0.1 (academic research; +https://ptit.edu.vn)

# Giãn cách giữa hai lần gọi cùng một tên miền, tính bằng giây. Đừng hạ dưới 1 — gọi dồn
# dập vào máy chủ của báo là hành vi xấu và sẽ bị chặn IP.
CRAWLER_DOMAIN_DELAY=1.5

# Múi giờ cho lịch chạy nền. Đặt sai thì "2h sáng" thành 2h sáng giờ UTC.
CRAWLER_TIMEZONE=Asia/Ho_Chi_Minh

# --- Lắng nghe mạng xã hội ----------------------------------------------------
# Worker chạy TRONG Docker đọc khoá từ đây; worker chạy ngoài Docker đọc từ
# apps/worker/.env. Để trống thì nguồn tương ứng tự bỏ qua kèm cảnh báo trong nhật ký,
# các nguồn còn lại vẫn chạy — không làm hỏng cả mẻ.
#
# Cách lấy: console.cloud.google.com → APIs & Services → Credentials → Create API key,
# rồi bật "YouTube Data API v3" và "Custom Search API" CHO ĐÚNG PROJECT chứa khoá đó.
# Khoá bị hạn chế loại API sẽ trả 403 với thông báo nói về project, rất dễ chẩn đoán nhầm.
# Kiểm tra nhanh: cd apps/worker && uv run python -m nlp ... hoặc `python -m social kiem-tra-khoa`
GOOGLE_API_KEY=

# Chỉ điền khi muốn tách quyền hoặc tách hạn mức giữa hai nguồn. Để trống thì cả hai
# dùng GOOGLE_API_KEY ở trên.
YOUTUBE_API_KEY=
GOOGLE_CSE_KEY=

# Mã Programmable Search Engine, tạo ở programmablesearchengine.google.com (miễn phí,
# không cần thẻ). Bật "Search the entire web" thì mới tìm được trong diễn đàn.
GOOGLE_CSE_CX=

# Reddit không cần khoá nhưng chặn rất gắt: trả 429 thất thường kể cả khi gọi thưa.
# Giãn cách giữa hai lần gọi, và thời gian chờ lần đầu sau khi bị từ chối (giây).
# Hạ hai giá trị này xuống thì mất nhiều từ khoá hơn, không phải chạy nhanh hơn.
REDDIT_DELAY=8
REDDIT_BACKOFF=12

# --- Token của Google Analytics 4 ---------------------------------------------
# KHÔNG khai ở đây. GA4 dùng OAuth (client id + secret + refresh token) và chỉ worker
# chạy ngoài Docker mới cần — xem apps/worker/.env.example.
