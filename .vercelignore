# Danh sách loại trừ khi tải mã nguồn lên Vercel.
#
# Khi có file này, Vercel KHÔNG dùng .gitignore nữa — nên đây phải là bản sao của
# .gitignore cộng thêm phần bí mật. Giữ hai file khớp nhau khi sửa.
#
# Lý do phải có riêng: .secrets/google.json từng bị git theo dõi, mà file đã được
# theo dõi thì .gitignore không loại trừ được nữa. Liệt kê tường minh ở đây để bí
# mật không bao giờ rời khỏi máy, bất kể tình trạng của git.

# Bí mật & cấu hình môi trường — TUYỆT ĐỐI không tải lên
.secrets/
.secrets
.env
.env.*
!.env.example
*.pem
*.key
airbyte/**/secrets*.json

# Không cần cho việc build web
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

node_modules/
.pnpm-store/
.next/
out/
dist/
build/
.turbo/
npm-debug.log*
pnpm-debug.log*

.vercel

dbt/target/
dbt/dbt_packages/
dbt/logs/

# Tài liệu nhiệm vụ nội bộ
*.doc
*.docx
*.xls
*.xlsx
*.pdf

# Dữ liệu & log cục bộ
*.log
data/
pgdata/
*.duckdb
*.duckdb.wal

.claude/settings.local.json

.DS_Store
Thumbs.db
.idea/
.vscode/
